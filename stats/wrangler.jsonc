// Nuluvium stats Worker, Robinhood Chain TESTNET. Secret (not in this file): PRIVATE_RPC_URL.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "darkpool-stats-testnet",
  "main": "src/worker.js",
  // Served at stats.nuluvium.com only (custom domain; Cloudflare makes the DNS record and certificate).
  "routes": [{ "pattern": "stats.nuluvium.com", "custom_domain": true }],
  "workers_dev": false,
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Every 10 minutes: one log query per 10,000 new blocks, then the summary is recomputed.
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true },
  "kv_namespaces": [
    // events: pool and Router events read so far (public chain data); summary: the stats page JSON.
    { "binding": "STATS", "id": "6d1c18ed2fa34818840dc34dd79bc184" }
  ],
  "vars": {
    "CHAIN_ID": "46630",
    "RPC_URL": "https://rpc.testnet.chain.robinhood.com",
    "POOL": "0x2B38bF53acc21a51603E68f5BC3bC8943B01fD4a",
    "ROUTER": "0x3287C2947f137c20c8BfeB628f800D23b8e5D155",
    "USDG": "0xd26d58F86cf82c702b558D6E7F159939E97F0Bfa",
    // L2 block of the pool deploy (same as the ASP).
    "DEPLOY_BLOCK": "153603397",
    "ASP_URL": "https://asp.nuluvium.com",
    "RELAYER_URL": "https://relayer.nuluvium.com",
    // Lowercase token address → symbol, for the routed-volume split.
    "TOKEN_SYMBOLS": "{\"0xf2a0289ec25994dc7d22461afd1df3b818a0e088\":\"MSTK\"}"
  }
}
