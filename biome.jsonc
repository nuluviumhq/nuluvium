// Lint for every package (`npm run lint` at the root). Formatting is not enforced.
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/.open-next",
      "!**/.wrangler",
      "!contracts/lib",
      "!contracts/out",
      "!contracts/cache",
      "!web/public",
      "!testnet/artifacts",
      "!testnet/runs",
      // Generated by `wrangler types`.
      "!web/cloudflare-env.d.ts",
      // globals.css is the design prototype's stylesheet, kept identical on purpose.
      "!**/*.css"
    ]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // Index keys only appear on fixed decorative tile grids, where the position is the identity.
        "noArrayIndexKey": "off"
      },
      "a11y": {
        // The pickers are labelled role="group" spans styled by the shared stylesheet; a fieldset
        // would bring browser styles the design does not have.
        "useSemanticElements": "off"
      }
    }
  }
}
