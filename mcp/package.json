{
  "name": "@nuluvium/mcp",
  "mcpName": "com.nuluvium/mcp",
  "version": "0.2.1",
  "type": "module",
  "description": "Nuluvium MCP server: lets an AI agent trade Robinhood Chain stock tokens privately, from its own machine",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuluviumhq/nuluvium.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/nuluviumhq/nuluvium/blob/main/docs/mcp.md",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "privacy",
    "robinhood-chain",
    "privacy-pools"
  ],
  "bin": {
    "nuluvium-mcp": "./dist/mcp/src/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build && node -e \"require('fs').copyFileSync('../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "@0xbow/privacy-pools-core-sdk": "1.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@scure/bip39": "1.5.4",
    "poseidon-lite": "0.3.0",
    "viem": "2.57.17",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@0xbow/privacy-pools-core-sdk": {
      "viem": "2.57.17"
    }
  }
}
