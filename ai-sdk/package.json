{
  "name": "@nuluvium/ai-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Nuluvium tools for the Vercel AI SDK: private stock-token trades on Robinhood Chain for your agent",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuluviumhq/nuluvium.git",
    "directory": "ai-sdk"
  },
  "homepage": "https://nuluvium.com/docs/agents/ai-sdk",
  "keywords": [
    "ai-sdk",
    "vercel-ai-sdk",
    "ai-agent",
    "tools",
    "mcp",
    "privacy",
    "robinhood-chain",
    "defi"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build && node -e \"require('fs').copyFileSync('../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.103"
  },
  "peerDependencies": {
    "ai": ">=7"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "ai": "7.0.179",
    "typescript": "5.9.3"
  }
}
