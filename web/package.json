{
  "name": "nuluvium-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nuluvium web app: site and private-routing app (Next.js on Cloudflare Workers via OpenNext)",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "node --test \"lib/**/*.test.ts\"",
    "sdk:sync": "node -e \"require('fs').rmSync('node_modules/@nuluvium/sdk',{recursive:true,force:true})\" && npm install",
    "artifacts": "node scripts/copy-artifacts.mjs",
    "predev": "node scripts/copy-artifacts.mjs",
    "prebuild": "node scripts/copy-artifacts.mjs"
  },
  "dependencies": {
    "@nuluvium/sdk": "file:../sdk",
    "@opennextjs/cloudflare": "1.20.18",
    "@privy-io/react-auth": "3.52.0",
    "@solana/kit": "8.5.0",
    "@stripe/stripe-js": "1.54.2",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.57.17"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "wrangler": "4.166.0"
  },
  "overrides": {
    "viem": "$viem",
    "underscore": "1.13.8",
    "ws": "8.23.0"
  }
}
