# Install file: dependencies (the SDK in ../sdk) as copies, not symlinks, so Next sees them inside
# this project. Run npm install here again after changing the SDK.
install-links=true
# Privy lists permissionless (smart wallets, unused here) as an optional peer that wants a newer ox
# than this app's viem; skip peer auto-install instead of upgrading viem everywhere.
legacy-peer-deps=true
